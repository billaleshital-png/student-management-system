import csv
import os

FILE_NAME = "students.csv"

#github
def create_file():
    """Create CSV file if it does not exist."""
    if not os.path.exists(FILE_NAME):
        with open(FILE_NAME, "w", newline="") as file:
            writer = csv.writer(file)
            writer.writerow([
                "Roll No",
                "Name",
                "Age",
                "Course",
                "Marks"
            ])


def add_student():
    print("\n----- Add Student -----")

    roll_no = input("Enter Roll Number: ")
    name = input("Enter Student Name: ")
    age = input("Enter Age: ")
    course = input("Enter Course: ")

    try:
        marks = float(input("Enter Marks: "))

        if marks < 0 or marks > 100:
            print("Marks must be between 0 and 100.")
            return

    except ValueError:
        print("Please enter valid marks.")
        return

    with open(FILE_NAME, "a", newline="") as file:
        writer = csv.writer(file)
        writer.writerow([
            roll_no,
            name,
            age,
            course,
            marks
        ])

    print("Student added successfully!")


def view_students():
    print("\n----- All Students -----")

    with open(FILE_NAME, "r") as file:
        reader = csv.DictReader(file)

        students_found = False

        print(
            f"{'Roll No':<10}"
            f"{'Name':<20}"
            f"{'Age':<8}"
            f"{'Course':<20}"
            f"{'Marks':<10}"
        )

        print("-" * 68)

        for student in reader:
            students_found = True

            print(
                f"{student['Roll No']:<10}"
                f"{student['Name']:<20}"
                f"{student['Age']:<8}"
                f"{student['Course']:<20}"
                f"{student['Marks']:<10}"
            )

        if not students_found:
            print("No student records found.")


def search_student():
    print("\n----- Search Student -----")

    roll_no = input("Enter Roll Number to search: ")

    with open(FILE_NAME, "r") as file:
        reader = csv.DictReader(file)

        for student in reader:
            if student["Roll No"] == roll_no:
                print("\nStudent Found!")
                print("Roll No:", student["Roll No"])
                print("Name:", student["Name"])
                print("Age:", student["Age"])
                print("Course:", student["Course"])
                print("Marks:", student["Marks"])
                return

    print("Student not found.")


def update_student():
    print("\n----- Update Student -----")

    roll_no = input("Enter Roll Number to update: ")

    students = []
    found = False

    with open(FILE_NAME, "r") as file:
        reader = csv.DictReader(file)

        for student in reader:
            if student["Roll No"] == roll_no:
                found = True

                print("\nEnter new details:")

                student["Name"] = input("Enter Name: ")
                student["Age"] = input("Enter Age: ")
                student["Course"] = input("Enter Course: ")

                try:
                    marks = float(input("Enter Marks: "))

                    if marks < 0 or marks > 100:
                        print("Marks must be between 0 and 100.")
                        return

                    student["Marks"] = marks

                except ValueError:
                    print("Invalid marks.")
                    return

            students.append(student)

    if found:
        with open(FILE_NAME, "w", newline="") as file:
            fieldnames = [
                "Roll No",
                "Name",
                "Age",
                "Course",
                "Marks"
            ]

            writer = csv.DictWriter(
                file,
                fieldnames=fieldnames
            )

            writer.writeheader()
            writer.writerows(students)

        print("Student updated successfully!")

    else:
        print("Student not found.")


def delete_student():
    print("\n----- Delete Student -----")

    roll_no = input("Enter Roll Number to delete: ")

    students = []
    found = False

    with open(FILE_NAME, "r") as file:
        reader = csv.DictReader(file)

        for student in reader:
            if student["Roll No"] == roll_no:
                found = True
            else:
                students.append(student)

    if found:
        with open(FILE_NAME, "w", newline="") as file:
            fieldnames = [
                "Roll No",
                "Name",
                "Age",
                "Course",
                "Marks"
            ]

            writer = csv.DictWriter(
                file,
                fieldnames=fieldnames
            )

            writer.writeheader()
            writer.writerows(students)

        print("Student deleted successfully!")

    else:
        print("Student not found.")


def average_marks():
    print("\n----- Average Marks -----")

    total = 0
    count = 0

    with open(FILE_NAME, "r") as file:
        reader = csv.DictReader(file)

        for student in reader:
            total += float(student["Marks"])
            count += 1

    if count == 0:
        print("No student records found.")
    else:
        average = total / count
        print(f"Average Marks: {average:.2f}")


def top_student():
    print("\n----- Top Student -----")

    students = []

    with open(FILE_NAME, "r") as file:
        reader = csv.DictReader(file)

        for student in reader:
            students.append(student)

    if not students:
        print("No student records found.")
        return

    top = max(
        students,
        key=lambda student: float(student["Marks"])
    )

    print("Top Student")
    print("-----------")
    print("Roll No:", top["Roll No"])
    print("Name:", top["Name"])
    print("Course:", top["Course"])
    print("Marks:", top["Marks"])


def main():
    create_file()

    while True:
        print("\n====================================")
        print("   STUDENT DATA MANAGEMENT SYSTEM")
        print("====================================")
        print("1. Add Student")
        print("2. View All Students")
        print("3. Search Student")
        print("4. Update Student")
        print("5. Delete Student")
        print("6. Average Marks")
        print("7. Top Student")
        print("8. Exit")

        choice = input("Enter your choice: ")

        if choice == "1":
            add_student()

        elif choice == "2":
            view_students()

        elif choice == "3":
            search_student()

        elif choice == "4":
            update_student()

        elif choice == "5":
            delete_student()

        elif choice == "6":
            average_marks()

        elif choice == "7":
            top_student()

        elif choice == "8":
            print("Thank you for using Student Data Management System!")
            break

        else:
            print("Invalid choice. Please try again.")


if __name__ == "__main__":
    main()